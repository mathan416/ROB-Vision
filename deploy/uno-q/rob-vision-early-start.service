# Change log:
#   2026-09-04 - Added a startup helper without changing system services or firmware.
# Full history: docs/CHANGELOG.md and Git history.

[Unit]
Description=R.O.B. Vision early-start startup helper

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/.local/lib/rob-vision/rob-vision-early-start.py --wait-router --release
TimeoutStartSec=55

[Install]
WantedBy=default.target
