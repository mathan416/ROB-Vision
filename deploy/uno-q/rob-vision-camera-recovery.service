# Project: R.O.B. Vision
# File: deploy/uno-q/rob-vision-camera-recovery.service
# Purpose: Run the fixed-purpose R.O.B. Vision camera USB recovery helper as root.
# Author: Iain Bennett
# Copyright (c) 2026 Iain Bennett
# SPDX-License-Identifier: MIT
# Change log:
#   2026-09-09 - Allowed time for capability probing and a real per-port power cycle.
#   2026-09-05 - Added the fixed-purpose root recovery service.
# Full history: docs/CHANGELOG.md and Git history.

[Unit]
Description=Recover the R.O.B. Vision USB camera
ConditionPathExists=/home/arduino/ArduinoApps/rob-vision/data/.camera-recovery-enabled

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/libexec/rob-vision-camera-recovery
TimeoutStartSec=40
