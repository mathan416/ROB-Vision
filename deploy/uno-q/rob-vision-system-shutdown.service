# Project: R.O.B. Vision
# File: deploy/uno-q/rob-vision-system-shutdown.service
# Purpose: Consume an authorized shutdown request and initiate a non-blocking UNO Q halt.
# Author: Iain Bennett
# Copyright (c) 2026 Iain Bennett
# SPDX-License-Identifier: MIT
# Change log:
#   2026-09-03 - Added with standardized source documentation.
#   2026-09-03 - Request halt to avoid UNO Q rebooting after poweroff.
# Full history: docs/CHANGELOG.md and Git history.

[Unit]
Description=Shut down the UNO Q for R.O.B. Vision
ConditionPathExists=/home/arduino/ArduinoApps/rob-vision/data/.shutdown-enabled

[Service]
Type=oneshot
ExecStart=/usr/bin/rm -f /home/arduino/ArduinoApps/rob-vision/data/shutdown-request
ExecStart=/usr/bin/systemctl --no-block halt
