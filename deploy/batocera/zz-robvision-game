#!/bin/sh
# Batocera launch hook. Invoked after generated RetroArch configuration exists.
APP=/userdata/system/rob-vision
[ "${2:-}" = nes ] || exit 0
# The notifier checks the editable console registry for this NES filename.
case "${1:-}" in
    gameStart) action=start ;;
    gameStop) action=end ;;
    *) exit 0 ;;
esac
if [ "$action" = start ] && [ -f /userdata/system/virtualglove/data/controller-router.json ] && \
   [ ! -f /userdata/system/scripts/virtualglove-game ]; then
    (cd "$APP" && CONTROLLER_ROUTER_SOURCES_FILE="$APP/config/router_sources.json" python3 -m router_shared.controller_router apply --platform batocera \
        --config /userdata/system/virtualglove/data/controller-router.json) \
        >/dev/null 2>&1 || echo "R.O.B. Vision: Controller Router could not apply this game's ports" >&2
fi
ROB_VISION_URL="$(cat "$APP/controller.url")" \
ROB_VISION_TOKEN_FILE="$APP/token" \
ROB_VISION_RECEIVER=batocera \
python3 "$APP/tools/notify_game.py" "$action" "${2:-}" "${3:-}" "${5:-}" \
    --timeout 0.3 --attempts 1 >/dev/null 2>&1 || :
