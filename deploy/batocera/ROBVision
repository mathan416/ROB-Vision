#!/bin/sh
# Persistent Batocera service. VirtualGlove may already provide writable core overlays.
set -eu
APP=/userdata/system/rob-vision
RUN=/run/rob-vision
ROUTER_CONFIG=/userdata/system/virtualglove/data/controller-router.json
ROUTER_SOCKET=/run/virtualglove/merged-gamepad.sock

mounted_at() { awk -v target="$1" '$2 == target { found=1 } END { exit !found }' /proc/mounts; }
overlay() {
    target="$1"; name="$2"
    if mounted_at "$target"; then return; fi
    mkdir -p "$RUN/$name-upper" "$RUN/$name-work" "$RUN/$name-merged"
    mount -t overlay "robvision-$name" -o "lowerdir=$target,upperdir=$RUN/$name-upper,workdir=$RUN/$name-work" "$RUN/$name-merged"
    mount --bind "$RUN/$name-merged" "$target"
}
wait_for_virtualglove_core() {
    # Batocera starts enabled user services concurrently. VirtualGlove may
    # mount (or reset) the same core paths during its startup. Let it finish
    # before placing our wrappers into whichever overlay owns those paths.
    [ -f /userdata/system/services/VirtualGlove ] || return 0
    enabled=$(batocera-settings-get system.services 2>/dev/null || :)
    case " $enabled " in *" VirtualGlove "*) ;; *) return 0 ;; esac
    count=0
    while [ "$count" -lt 30 ]; do
        [ -f /usr/lib/libretro/nestopia_powerglove_libretro.so ] && return 0
        sleep 1
        count=$((count + 1))
    done
    echo "R.O.B. Vision: VirtualGlove core was not ready; continuing with R.O.B. Vision cores" >&2
}
start() {
    mkdir -p "$RUN"
    if [ -f /userdata/system/controller-router/generator-path ]; then
        PYTHONPATH=/userdata/system/controller-router/lib python3 -c 'from router_shared.launch_install import activate_batocera; activate_batocera()'
    fi
    wait_for_virtualglove_core
    overlay /usr/lib/libretro core
    overlay /usr/share/libretro/info info
    for core in fceumm nestopia; do
        [ -f "$APP/build/robvision_${core}_libretro.so" ] || continue
        cp "$APP/build/robvision_${core}_libretro.so" "/usr/lib/libretro/robvision_${core}_libretro.so"
        cp "/usr/share/libretro/info/${core}_libretro.info" "/usr/share/libretro/info/robvision_${core}_libretro.info"
        chmod 755 "/usr/lib/libretro/robvision_${core}_libretro.so"
        chmod 644 "/usr/share/libretro/info/robvision_${core}_libretro.info"
    done
    [ -s "$APP/token" ] || return 0
    if [ -f "$RUN/receiver.pid" ] && kill -0 "$(cat "$RUN/receiver.pid")" 2>/dev/null; then return 0; fi
    modprobe uinput 2>/dev/null || :
    ROB_VISION_URL="$(cat "$APP/controller.url")" \
    ROB_VISION_TOKEN_FILE="$APP/token" \
    CONTROLLER_ROUTER_SOURCES_FILE="$APP/config/router_sources.json" \
    python3 "$APP/tools/retropie_controller2.py" --platform batocera --swap-buttons \
        >>"$APP/receiver.log" 2>&1 &
    echo "$!" >"$RUN/receiver.pid"
    if [ -f "$ROUTER_CONFIG" ] && [ ! -S "$ROUTER_SOCKET" ]; then
        mkdir -p /run/virtualglove
        cd "$APP"
        export CONTROLLER_ROUTER_SOURCES_FILE="$APP/config/router_sources.json"
        python3 -m router_shared.controller_router serve --platform batocera \
            --config "$ROUTER_CONFIG" --socket "$ROUTER_SOCKET" \
            >>"$APP/router.log" 2>&1 &
        echo "$!" >"$RUN/router.pid"
    fi
}
stop() {
    if [ -f "$RUN/router.pid" ]; then
        router_pid=$(cat "$RUN/router.pid")
        kill "$router_pid" 2>/dev/null || :
        count=0
        while kill -0 "$router_pid" 2>/dev/null && [ "$count" -lt 50 ]; do
            sleep 0.1
            count=$((count + 1))
        done
        rm -f "$RUN/router.pid"
    fi
    if [ -f "$RUN/receiver.pid" ]; then
        receiver_pid=$(cat "$RUN/receiver.pid")
        kill "$receiver_pid" 2>/dev/null || :
        count=0
        while kill -0 "$receiver_pid" 2>/dev/null && [ "$count" -lt 50 ]; do
            sleep 0.1
            count=$((count + 1))
        done
        rm -f "$RUN/receiver.pid"
    fi
}
case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    status) [ -f "$RUN/receiver.pid" ] && kill -0 "$(cat "$RUN/receiver.pid")" 2>/dev/null ;;
    *) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 2 ;;
esac
