[Unit]
Description=R.O.B. Vision virtual controller and dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/arduino/ArduinoApps/rob-vision
EnvironmentFile=/home/arduino/.config/rob-vision/environment
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/arduino/ArduinoApps/rob-vision/.deps
ExecStart=/usr/bin/python3 -m controller.service --host 0.0.0.0 --port 8766
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=default.target
