[Unit]
Description=R.O.B. Vision RetroPie controller and frame receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/home/pi/.config/rob-vision/receiver.env
ExecStart=/usr/bin/python3 /home/pi/rob-vision/tools/retropie_controller2.py
Restart=always
RestartSec=2
User=root
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
RuntimeDirectory=rob-vision
RuntimeDirectoryMode=0755
ReadWritePaths=/dev/uinput /run/rob-vision /home/pi/rob-vision/config /opt/retropie/configs/all /opt/retropie/configs/nes

[Install]
WantedBy=multi-user.target
