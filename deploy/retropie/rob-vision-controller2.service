[Unit]
Description=R.O.B. Vision RetroPie controller and frame receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/pi/rob-vision/tools/retropie_controller2.py --url http://arduiain.local --token-file /home/pi/.config/rob-vision/token
Restart=always
RestartSec=2
User=root
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
RuntimeDirectory=rob-vision
RuntimeDirectoryMode=0755
ReadWritePaths=/dev/uinput /run/rob-vision

[Install]
WantedBy=multi-user.target
